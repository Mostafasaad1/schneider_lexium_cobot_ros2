<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Lexium_Cobot_L18S002">
    <xacro:arg name="use_ros2_control" default="false"/>
    <xacro:arg name="use_mock_hardware" default="false"/>
    <xacro:arg name="use_sim" default="true"/>
    <xacro:arg name="controllers_file" default=""/>
    <xacro:include filename="Lexium_Cobot_L18S002.urdf"/>
    <xacro:include filename="Lexium_Cobot_L18S002_sensors.urdf.xacro"/>
    <xacro:include filename="Lexium_Cobot_L18S002_ros2_control.urdf.xacro"/>
    <xacro:if value="$(arg use_ros2_control)">
      <xacro:lexium_ros2_control controllers_file="$(arg controllers_file)" use_sim="$(arg use_sim)" use_mock_hardware="$(arg use_mock_hardware)"/>
    </xacro:if>
</robot>
