<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =================================================================== -->
  <!-- Generic Industrial Vacuum Suction Gripper Macro                    -->
  <!-- =================================================================== -->
  <xacro:macro name="generic_vacuum_gripper" params="parent prefix:=vacuum_ *origin">

    <!-- Vacuum Flange & Manifold Body -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.0 0.0 0.025" rpy="0 0 0"/>
        <mass value="0.45"/>
        <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.0003"/>
      </inertial>
      <!-- Base mounting flange -->
      <visual>
        <origin xyz="0.0 0.0 0.006" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.045" length="0.012"/>
        </geometry>
        <material name="vacuum_anodized">
          <color rgba="0.18 0.19 0.22 1.0"/>
        </material>
      </visual>
      <!-- Manifold & pneumatic valve housing -->
      <visual>
        <origin xyz="0.0 0.0 0.028" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.028" length="0.032"/>
        </geometry>
        <material name="vacuum_silver">
          <color rgba="0.75 0.77 0.80 1.0"/>
        </material>
      </visual>
      <!-- Status ring accent -->
      <visual>
        <origin xyz="0.0 0.0 0.046" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.030" length="0.004"/>
        </geometry>
        <material name="schneider_green_accent">
          <color rgba="0.24 0.70 0.28 1.0"/>
        </material>
      </visual>
      <!-- Collision -->
      <collision>
        <origin xyz="0.0 0.0 0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.045" length="0.050"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <!-- Bellows Suction Cup -->
    <link name="${prefix}suction_cup">
      <inertial>
        <origin xyz="0.0 0.0 0.020" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
      <!-- Bellows cone 1 -->
      <visual>
        <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.020" length="0.012"/>
        </geometry>
        <material name="suction_elastomer">
          <color rgba="0.10 0.11 0.12 1.0"/>
        </material>
      </visual>
      <!-- Bellows cup lip -->
      <visual>
        <origin xyz="0.0 0.0 0.022" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.026" length="0.012"/>
        </geometry>
        <material name="suction_elastomer"/>
      </visual>
      <!-- Collision -->
      <collision>
        <origin xyz="0.0 0.0 0.016" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.028" length="0.032"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}cup_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}suction_cup"/>
      <origin xyz="0.0 0.0 0.048" rpy="0 0 0"/>
    </joint>

    <!-- Vacuum Tool Center Point (TCP) / Suction Face -->
    <link name="${prefix}tcp_link"/>
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}suction_cup"/>
      <child link="${prefix}tcp_link"/>
      <origin xyz="0.0 0.0 0.028" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo Physics & Materials -->
    <gazebo reference="${prefix}base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="${prefix}suction_cup">
      <material>Gazebo/Black</material>
      <kp>100000.0</kp>
      <kd>10.0</kd>
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
    </gazebo>

  </xacro:macro>

</robot>
