<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pick_and_place_cell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Illumination & Atmosphere -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>2.0 -2.0 8.0 0 0 0</pose>
      <diffuse>0.85 0.85 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <light type="point" name="cell_fill_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>0.5 0.6 2.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.65 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light type="point" name="cell_fill_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>0.5 -0.6 2.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.65 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.21 1</ambient>
            <diffuse>0.22 0.23 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot Mounting Base Pedestal -->
    <model name="robot_pedestal">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="pedestal_link">
        <collision name="pedestal_collision">
          <geometry>
            <cylinder>
              <radius>0.16</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="pedestal_visual">
          <geometry>
            <cylinder>
              <radius>0.16</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.13 0.15 1</ambient>
            <diffuse>0.15 0.16 0.18 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 1. Pick Table (Source Workbench on Left / +Y) -->
    <model name="pick_table">
      <static>true</static>
      <pose>0.45 0.55 0.15 0 0 0</pose>
      <link name="pick_table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.40 0.40 0.30</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <!-- Main body -->
        <visual name="table_body">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.38 0.38 0.28</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.22 0.25 1</ambient>
            <diffuse>0.25 0.27 0.30 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <!-- Top work plate with green indicator perimeter -->
        <visual name="table_top">
          <pose>0 0 0.145 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.40 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.28 0.30 0.34 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <!-- Pick Zone Target Outline -->
        <visual name="pick_zone_marker">
          <pose>0 0 0.151 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.65 0.25 1</ambient>
            <diffuse>0.24 0.70 0.28 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. Place Table (Destination Workbench on Right / -Y) -->
    <model name="place_table">
      <static>true</static>
      <pose>0.45 -0.55 0.15 0 0 0</pose>
      <link name="place_table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.40 0.40 0.30</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <!-- Main body -->
        <visual name="table_body">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.38 0.38 0.28</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.22 0.25 1</ambient>
            <diffuse>0.25 0.27 0.30 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <!-- Top work plate with blue indicator perimeter -->
        <visual name="table_top">
          <pose>0 0 0.145 0 0 0</pose>
          <geometry>
            <box>
              <size>0.40 0.40 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.28 0.30 0.34 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <!-- Place Zone Target Outline -->
        <visual name="place_zone_marker">
          <pose>0 0 0.151 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.45 0.85 1</ambient>
            <diffuse>0.20 0.55 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. Target Workpiece (Cylindrical Industrial Workpiece) -->
    <model name="target_workpiece">
      <pose>0.45 0.55 0.34 0 0 0</pose>
      <link name="workpiece_link">
        <inertial>
          <mass>0.35</mass>
          <inertia>
            <ixx>0.00024</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.00024</iyy>
            <iyz>0.0</iyz>
            <izz>0.00011</izz>
          </inertia>
        </inertial>
        <collision name="workpiece_collision">
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.080</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                <kp>10000000.0</kp>
                <kd>10.0</kd>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="workpiece_visual">
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.080</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.90 0.40 0.10 1</ambient>
            <diffuse>0.98 0.48 0.12 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
        <!-- Top cap accent -->
        <visual name="workpiece_cap">
          <pose>0 0 0.040 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.023</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.20 0.22 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
